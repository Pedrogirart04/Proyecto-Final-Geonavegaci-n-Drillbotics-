"""
probar_red_UCS.py — Probar la red entrenada con inputs manuales (Fase C)
===========================================================================
Script simple para validar la red (ROP, RPM, WOB) -> UCS "a mano":
ingresás ROP, RPM y un UCS "real" (supuesto conocido, por ej. de una
probeta ya ensayada), el script calcula con la fórmula analítica el WOB
que correspondería a esos valores, se lo pasa a la red, y compara el UCS
estimado contra el real. Es el mismo chequeo que se hace al final de
main.py pero interactivo, para probar varios valores sin reentrenar.

Para correr: python probar_red_UCS.py
Requiere: modelo_UCS.pth (generado por main.py) — si lo renombraste al
guardar (como hiciste con el de Fase B), cambiá el nombre por default
en cargar_modelo() más abajo.
"""

import torch
import numpy as np
from modelo import RedBHA
from datos import desnormalizar_y, normalizar_X
from config import A_TREPANO


def cargar_modelo(ruta="modelo_vert_WOB_RPM_ROP_UCS.pth"):
    checkpoint = torch.load(ruta, weights_only=False)
    modelo = RedBHA(capas=checkpoint['capas'])
    modelo.load_state_dict(checkpoint['model_state_dict'])
    modelo.eval()
    stats = checkpoint['stats']
    return modelo, stats


def predecir_UCS(modelo, stats, rop, rpm, wob):
    """Evalúa la red (ROP, RPM, WOB) -> UCS."""
    X = np.array([[rop, rpm, wob]])
    X_tensor = normalizar_X(X, stats)

    with torch.no_grad():
        UCS_estimado = desnormalizar_y(modelo(X_tensor), stats).item()

    return UCS_estimado


def wob_formula(rop, rpm, ucs, a=A_TREPANO):
    """Fórmula analítica directa (ROP, RPM, UCS) -> WOB, para generar el
    WOB 'medido' a partir de un UCS real conocido (ej. probeta ensayada).
    Esto es solo para probar con datos sintéticos: cuando tengas datos
    reales de laboratorio, el WOB lo vas a tener medido directamente,
    no calculado — ahí este paso se reemplaza por el dato de la tabla."""
    return np.pi * a * ucs * rop / (2 * rpm)


# ─────────────────────────────────────────────────────────────

if __name__ == "__main__":

    modelo, stats = cargar_modelo()
    print("Modelo cargado. Ingresá ROP, RPM y el UCS real para probar.")
    print("El script calcula el WOB con la fórmula y se lo pasa a la red,")
    print("para comparar el UCS que estima contra el real que ingresaste.")
    print("Escribí 'salir' para terminar.\n")

    while True:
        try:
            entrada = input("ROP [mm/min], RPM, UCS_real [MPa]: ")

            if entrada.strip().lower() == 'salir':
                break

            valores = [float(v.strip()) for v in entrada.split(",")]
            rop, rpm, ucs_real = valores

            wob = wob_formula(rop, rpm, ucs_real)
            ucs_estimado = predecir_UCS(modelo, stats, rop, rpm, wob)
            error = ucs_estimado - ucs_real
            error_rel = (error/ucs_real)*100

            print(f"  WOB (fórmula):       {wob:.3f} N")
            print(f"  UCS real:            {ucs_real:.2f} MPa")
            print(f"  UCS estimado (red):  {ucs_estimado:.2f} MPa")
            print(f"  Error:               {error:.3f} MPa\n")
            print(f"  Error Rel:               {error_rel:.3f} %\n")

        except ValueError:
            print("  Formato incorrecto. Ejemplo: 15, 1500, 25\n")
        except Exception as e:
            print(f"  Error: {e}\n")